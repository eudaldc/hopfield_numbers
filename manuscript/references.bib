@article{piazza_subitizing_2011,
	title = {Subitizing reflects visuo-spatial object individuation capacity},
	volume = {121},
	issn = {00100277},
	doi = {10.1016/j.cognition.2011.05.007},
	abstract = {Subitizing is the immediate apprehension of the exact number of items in small sets. Despite more than a 100. years of research around this phenomenon, its nature and origin are still unknown. One view posits that it reflects a number estimation process common for small and large sets, which precision decreases as the number of items increases, according to Weber's law. Another view proposes that it reflects a non-numerical mechanism of visual indexing of multiple objects in parallel that is limited in capacity. In a previous research we have gathered evidence against the Weberian estimation hypothesis. Here we provide first direct evidence for the alternative object indexing hypothesis, and show that subitizing reflects a domain general mechanism shared with other tasks that require multiple object individuation. © 2011 Elsevier B.V.},
	number = {1},
	journal = {Cognition},
	author = {Piazza, Manuela and Fumarola, Antonia and Chinello, Alessandro and Melcher, David},
	month = oct,
	year = {2011},
	keywords = {/unread, Approximate Number System, Core, Research, Subitizing, Visuo-spatial attention},
	pages = {147--153},
	file = {PDF:/home/eudald/Zotero/storage/UW3ZK9J2/Subitizing_reflects_visuo-spatial_object20161010-18908-oszwv7-with-cover-page-v2.pdf:application/pdf},
}

@article{feigenson_representations_2002,
	title = {The representations underlying infants' choice of more: object files versus analog magnitudes},
	volume = {13},
	issn = {0956-7976},
	shorttitle = {The representations underlying infants' choice of more},
	doi = {10.1111/1467-9280.00427},
	abstract = {A new choice task was used to explore infants' spontaneous representations of more and less. Ten- and 12-month-old infants saw crackers placed sequentially into two containers, then were allowed to crawl and obtain the crackers from the container they chose. Infants chose the larger quantity with comparisons of 1 versus 2 and 2 versus 3, but failed with comparisons of 3 versus 4, 2 versus 4, and 3 versus 6. Success with visible arrays ruled out a motivational explanation for failure in the occluded 3-versus-6 condition. Control tasks ruled out the possibility that presentation duration guided choice, and showed that presentation complexity was not responsible for the failure with larger numbers. When crackers were different sizes, total surface area or volume determined choice. The infants 'pattern of success and failure supports the hypothesis that they relied on object-file representations, comparing mental models via total volume or surface area rather than via one-to-one correspondence between objectfiles.},
	language = {eng},
	number = {2},
	journal = {Psychological Science},
	author = {Feigenson, Lisa and Carey, Susan and Hauser, Marc},
	month = mar,
	year = {2002},
	keywords = {Attention, Choice Behavior, Discrimination Learning, Female, Humans, Infant, Male, Motivation, Orientation, Pattern Recognition, Visual, Problem Solving, Psychology, Child, Psychomotor Performance, Size Perception},
	pages = {150--156},
}

# Computational models

@article{dehaene_development_1993,
	title = {Development of elementary numerical abilities: {A} neuronal model},
	volume = {5},
	issn = {0898929X},
	doi = {10.1162/jocn.1993.5.4.390},
	abstract = {Despite their lack of language, human infants and several animal species possess some elementary abilities for numerical processing. These include the ability to recognize that a given numerosity is being presented visually or auditorily, and, at a later stage of development, the ability to compare two numerosities and to decide which is larger. We propose a model for the development of these abilities in a formal neuronal network. Initially, the model is equipped only with unordered numerosity detectors. It can therefore detect the numerosity of an input set and can be conditioned to react accordingly. In a later stage, the addition of a short-term memory network is shown to be sufficient for number comparison abilities to develop. Our computer simulations account for several phenomena in the numerical domain, including the distance effect and Fechner's law for numbers. They also demonstrate that infants' numerosity detection abilities may be explained without assuming that infants can count. The neurobiological bases of the critical components of the model are discussed.},
	number = {4},
	journal = {Journal of Cognitive Neuroscience},
	publisher = {MIT Press Journals},
	author = {Dehaene, Stanislas and Changeux, Jean Pierre},
	year = {1993},
	keywords = {Artificial intelligence, Cognition, Computational modeling, Mathematics, Neuroscience, Numerical cognition, Numerosity, Research},
	pages = {390--407},
	file = {PDF:/home/eudald/Zotero/storage/U9BEF73K/jocn.1993.5.4.390.pdf:application/pdf;PDF:/home/eudald/Zotero/storage/5LXAUQXZ/Dehaene i Changeux - 1993 - Development of elementary numerical abilities a neuronal model.pdf:application/pdf},
}

