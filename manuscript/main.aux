\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Joint fit of the model to the~\citet  {cheyette_unified_2020} data.} Columns show presentation times from 40 to 640~ms; rows show the mean estimate, exact accuracy $P(r=n)$, and geometric-mean response time. Dots are empirical data (faint dots in the RT column are the median, shown for reference); lines are the model, co-fitted across all three channels. Response time is a cross-prediction: the RT channel is fitted to the individual trial times, not to the curve shown. $R^2$ values are given per panel.}}{5}{figure.caption.15}\protected@file@percent }
\newlabel{fig:fit}{{3}{5}{\textbf {Joint fit of the model to the~\citet {cheyette_unified_2020} data.} Columns show presentation times from 40 to 640~ms; rows show the mean estimate, exact accuracy $P(r=n)$, and geometric-mean response time. Dots are empirical data (faint dots in the RT column are the median, shown for reference); lines are the model, co-fitted across all three channels. Response time is a cross-prediction: the RT channel is fitted to the individual trial times, not to the curve shown. $R^2$ values are given per panel}{figure.caption.15}{}}
