\newlabel{eq:rt}{{5}{3}{Methods}{equation.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Fit to estimation, accuracy, and response time across five exposure durations on the~\citet  {cheyette_unified_2020} dataset.} Rows show presentation times from 40 to 640~ms; columns show mean estimate, exact accuracy, and median response time. Boxplots and blue dots show empirical data, and red lines show model predictions (± SEM). The model captures fast, near-exact responses for $n = 1$--2/3, progressive degradation for $n = 3/4$--8, and a plateau for larger numerosities where attractor wells overlap. $R^2$ values are shown in each panel.}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:fit}{{2}{3}{\textbf {Fit to estimation, accuracy, and response time across five exposure durations on the~\citet {cheyette_unified_2020} dataset.} Rows show presentation times from 40 to 640~ms; columns show mean estimate, exact accuracy, and median response time. Boxplots and blue dots show empirical data, and red lines show model predictions (± SEM). The model captures fast, near-exact responses for $n = 1$--2/3, progressive degradation for $n = 3/4$--8, and a plateau for larger numerosities where attractor wells overlap. $R^2$ values are shown in each panel}{figure.caption.6}{}}
