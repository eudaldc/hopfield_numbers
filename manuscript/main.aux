\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Fit of the model to the~\citet  {cheyette_unified_2020} data across the three channels.} Columns show presentation times from 40 to 640~ms; rows show the mean estimate, exact accuracy $P(r=n)$, and geometric-mean response time. Dots are empirical data (faint dots in the RT column are the median, shown for reference); lines are the model, with the landscape fitted to the individual responses. Response time is evaluated in a constrained cross-channel fit: the landscape is held fixed at its response-fit values, and only the RT-link parameters are fitted to the individual trial times. The small shoulder in predicted exact accuracy occurs near the width-based proxy $n_{\mathrm  {width}}$ and disappears when clean-up is switched off (Supplementary Fig.~\ref {sup-fig:pexact}). $R^2$ values are given per panel.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:fit}{{3}{6}{\textbf {Fit of the model to the~\citet {cheyette_unified_2020} data across the three channels.} Columns show presentation times from 40 to 640~ms; rows show the mean estimate, exact accuracy $P(r=n)$, and geometric-mean response time. Dots are empirical data (faint dots in the RT column are the median, shown for reference); lines are the model, with the landscape fitted to the individual responses. Response time is evaluated in a constrained cross-channel fit: the landscape is held fixed at its response-fit values, and only the RT-link parameters are fitted to the individual trial times. The small shoulder in predicted exact accuracy occurs near the width-based proxy $n_{\mathrm {width}}$ and disappears when clean-up is switched off (Supplementary Fig.~\ref {sup-fig:pexact}). $R^2$ values are given per panel}{figure.caption.7}{}}
