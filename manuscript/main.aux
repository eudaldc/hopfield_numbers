\citation{cheyette_unified_2020}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Model comparison across exposure durations, response time, and the predicted resolution limit.} The model comparison is shown two ways: a joint fit, one fit shared across all five durations, and a separate fit per duration. \textbf  {a}, Accuracy channel, joint fit: a single landscape ($\sigma _c$, $\beta $) shared across all durations, with only the sensory channel and lapse free per duration. Cells are $\Delta $AIC relative to the best model (darker is better). With one landscape the frequency-well attractor is the best account and beats even the fully free per-duration Weber/ANS. \textbf  {b}, Accuracy channel, separate fits per duration, over the ${\sim }53{,}000$ individual responses. Each well family (frequency-based width, Eq.~\eqref  {eq:width}, free $\beta $; or power-law width $\sigma _n \propto n^{p}$) appears with its clean-up dynamics and as a matched static readout of the same wells (no extra parameters): clean-up wins at the briefest exposures and the static readouts catch up at 320--640~ms, as expected if the attractor has largely settled during the exposure itself. \textbf  {c}, Response-time channel, joint fit: one RT mapping shared across durations. \textbf  {d}, Response-time channel, separate fits on the winning landscape. In both, the link combining the attractor's convergence time and the residual readout entropy is best; convergence time alone stays close, while the static entropy proxy falls behind. \textbf  {e}, The fitted width law $\sigma _n$ per exposure duration. Wells are resolvable ($\sigma _n < 1$) at small $n$ and merge ($\sigma _n \ge 1$) beyond the critical numerosity $n_{\mathrm  {crit}}$ (dots), which grows from ${\approx }4.6$ at 40~ms to ${\approx }10$ at 640~ms: more exposure sharpens the wells and extends the exact range.}}{4}{figure.caption.13}\protected@file@percent }
\newlabel{fig:comparison}{{2}{4}{\textbf {Model comparison across exposure durations, response time, and the predicted resolution limit.} The model comparison is shown two ways: a joint fit, one fit shared across all five durations, and a separate fit per duration. \textbf {a}, Accuracy channel, joint fit: a single landscape ($\sigma _c$, $\beta $) shared across all durations, with only the sensory channel and lapse free per duration. Cells are $\Delta $AIC relative to the best model (darker is better). With one landscape the frequency-well attractor is the best account and beats even the fully free per-duration Weber/ANS. \textbf {b}, Accuracy channel, separate fits per duration, over the ${\sim }53{,}000$ individual responses. Each well family (frequency-based width, Eq.~\eqref {eq:width}, free $\beta $; or power-law width $\sigma _n \propto n^{p}$) appears with its clean-up dynamics and as a matched static readout of the same wells (no extra parameters): clean-up wins at the briefest exposures and the static readouts catch up at 320--640~ms, as expected if the attractor has largely settled during the exposure itself. \textbf {c}, Response-time channel, joint fit: one RT mapping shared across durations. \textbf {d}, Response-time channel, separate fits on the winning landscape. In both, the link combining the attractor's convergence time and the residual readout entropy is best; convergence time alone stays close, while the static entropy proxy falls behind. \textbf {e}, The fitted width law $\sigma _n$ per exposure duration. Wells are resolvable ($\sigma _n < 1$) at small $n$ and merge ($\sigma _n \ge 1$) beyond the critical numerosity $n_{\mathrm {crit}}$ (dots), which grows from ${\approx }4.6$ at 40~ms to ${\approx }10$ at 640~ms: more exposure sharpens the wells and extends the exact range}{figure.caption.13}{}}
\citation{anderson_reflections_1991,verguts_representation_2004}
\citation{butterworth_investigating_2017}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Co-fit of the model to the~\citet  {cheyette_unified_2020} data across the three channels.} Columns show presentation times from 40 to 640~ms; rows show the mean estimate, exact accuracy $P(r=n)$, and geometric-mean response time. Dots are empirical data (faint dots in the RT column are the median, shown for reference); lines are the model, co-fitted across all three channels. Response time is a cross-prediction: the RT channel is fitted to the individual trial times, not to the curve shown. The small shoulder in the predicted exact accuracy near the resolution limit $n_{\mathrm  {crit}}$ is a signature of the discrete clean-up basins; it disappears when the clean-up is switched off (Supplementary Material 4). $R^2$ values are given per panel.}}{5}{figure.caption.14}\protected@file@percent }
\newlabel{fig:fit}{{3}{5}{\textbf {Co-fit of the model to the~\citet {cheyette_unified_2020} data across the three channels.} Columns show presentation times from 40 to 640~ms; rows show the mean estimate, exact accuracy $P(r=n)$, and geometric-mean response time. Dots are empirical data (faint dots in the RT column are the median, shown for reference); lines are the model, co-fitted across all three channels. Response time is a cross-prediction: the RT channel is fitted to the individual trial times, not to the curve shown. The small shoulder in the predicted exact accuracy near the resolution limit $n_{\mathrm {crit}}$ is a signature of the discrete clean-up basins; it disappears when the clean-up is switched off (Supplementary Material 4). $R^2$ values are given per panel}{figure.caption.14}{}}
