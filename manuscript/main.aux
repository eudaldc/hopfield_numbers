\citation{dehaene_neural_2003}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {AIC comparison across exposure durations.} Bars show profile-Gaussian AIC values for the Hopfield--Poisson model and five alternatives, fitted to the same three summary curves used in the main analysis. Four of the models form a $2 \times 2$ design crossing the well family (Poisson vs.\ Gaussian--Benford) with the presence or absence of the clean-up step; the Weber/ANS code and the log-prior proxy serve as external benchmarks. The final group shows the across-duration mean for each model. Lower values indicate better fit after penalizing the four fitted parameters per duration.}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:aic_comparison}{{3}{4}{\textbf {AIC comparison across exposure durations.} Bars show profile-Gaussian AIC values for the Hopfield--Poisson model and five alternatives, fitted to the same three summary curves used in the main analysis. Four of the models form a $2 \times 2$ design crossing the well family (Poisson vs.\ Gaussian--Benford) with the presence or absence of the clean-up step; the Weber/ANS code and the log-prior proxy serve as external benchmarks. The final group shows the across-duration mean for each model. Lower values indicate better fit after penalizing the four fitted parameters per duration}{figure.caption.7}{}}
