\newlabel{eq:well}{{1}{2}{Methods}{equation.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Energy landscape of the Poisson attractor wells for $n = 1 \ldots  15$.} In \textbf  {a}, we show how the evenly shaped attractor wells following a Poisson distribution shape the energy landscape. In \textbf  {b} we show the posterior distribution and a representation of the clean-up procedure that stabilizes noisy input into one of the attractor wells. The histograms show the probabilities of settling in each of the real or adjacent wells. We can see how wells in the subitizing range have much less entropy and thus the input information is easier to clean, leading to a faster and more accurate response.}}{2}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:conceptual}{{1}{2}{\textbf {Energy landscape of the Poisson attractor wells for $n = 1 \ldots 15$.} In \textbf {a}, we show how the evenly shaped attractor wells following a Poisson distribution shape the energy landscape. In \textbf {b} we show the posterior distribution and a representation of the clean-up procedure that stabilizes noisy input into one of the attractor wells. The histograms show the probabilities of settling in each of the real or adjacent wells. We can see how wells in the subitizing range have much less entropy and thus the input information is easier to clean, leading to a faster and more accurate response}{figure.caption.4}{}}
