\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Summary-level model comparison on the~\citet  {cheyette_unified_2020} duration data.} AIC/BIC are profile-Gaussian values averaged across the five exposure durations, computed on mean estimate, exact accuracy, and median RT. LONO is leave-one-numerosity-out normalized predictive loss; LODO is leave-one-duration-out loss. The two attractor parameterizations (Hopfield--Poisson and its Gaussian--Benford variant) are listed above their respective no-clean-up controls. Lower values are better.}}{2}{table.caption.6}\protected@file@percent }
\newlabel{tab:supp_modelcomparison}{{S1}{2}{\textbf {Summary-level model comparison on the~\citet {cheyette_unified_2020} duration data.} AIC/BIC are profile-Gaussian values averaged across the five exposure durations, computed on mean estimate, exact accuracy, and median RT. LONO is leave-one-numerosity-out normalized predictive loss; LODO is leave-one-duration-out loss. The two attractor parameterizations (Hopfield--Poisson and its Gaussian--Benford variant) are listed above their respective no-clean-up controls. Lower values are better}{table.caption.6}{}}
