\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Summary-level model comparison on the~\citet  {cheyette_unified_2020} duration data.} AIC/BIC are profile-Gaussian values averaged across the five exposure durations, computed on mean estimate, exact accuracy, and median RT. $\Delta $ is the difference in mean AIC from the best model and $w$ the corresponding Akaike weight. LONO is leave-one-numerosity-out normalized predictive loss; LODO is leave-one-duration-out loss. Lower values are better.}}{2}{table.caption.6}\protected@file@percent }
\newlabel{tab:supp_modelcomparison}{{S1}{2}{\textbf {Summary-level model comparison on the~\citet {cheyette_unified_2020} duration data.} AIC/BIC are profile-Gaussian values averaged across the five exposure durations, computed on mean estimate, exact accuracy, and median RT. $\Delta $ is the difference in mean AIC from the best model and $w$ the corresponding Akaike weight. LONO is leave-one-numerosity-out normalized predictive loss; LODO is leave-one-duration-out loss. Lower values are better}{table.caption.6}{}}
