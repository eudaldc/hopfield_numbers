\citation{dolfi_weaker_2024}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {The effective Weber fraction.} Coefficient of variation of the response distribution $w_{\mathrm  {eff}}(n)$ per numerosity and exposure duration. Solid lines are the model (lapse included, restricted to in-support responses and renormalized), dots are the data, and dotted verticals mark $n_{\mathrm  {width}}$. The lines approach a roughly constant plateau at larger numerosities. The verticals identify the width-based analysis cutoff, not an exact-range boundary.}}{4}{figure.caption.16}\protected@file@percent }
\newlabel{fig:weber}{{S3}{4}{\textbf {The effective Weber fraction.} Coefficient of variation of the response distribution $w_{\mathrm {eff}}(n)$ per numerosity and exposure duration. Solid lines are the model (lapse included, restricted to in-support responses and renormalized), dots are the data, and dotted verticals mark $n_{\mathrm {width}}$. The lines approach a roughly constant plateau at larger numerosities. The verticals identify the width-based analysis cutoff, not an exact-range boundary}{figure.caption.16}{}}
\@writefile{toc}{\contentsline {section}{Supplementary Material 4: Exploratory reanalysis of developmental dyscalculia}{4}{section*.18}\protected@file@percent }
\newlabel{sm:dyscalculia}{{}{4}{Supplementary Material 4: Exploratory reanalysis of developmental dyscalculia}{section*.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {Developmental dyscalculia and a coarser fitted width profile.} (a)~Exact accuracy per numerosity (points, group mean $\pm $ SEM; lines, the group-level model fit). (b)~Median response time, same conventions. (c)~Per-subject accuracy SSE of the two single-mechanism fits: the width-only model fits better than the noise-only model in $64/64$ subjects (all points below the diagonal). (d)~Per-subject continuous width index $n_{\mathrm  {width}}$ from free-scale fits with a shared exponent at the task's $500$~ms exposure. Horizontal lines mark group medians; children with DD have lower $n_{\mathrm  {width}}$ than controls (Mann--Whitney $p=0.018$, $r_{\mathrm  {rb}}=-0.35$).}}{4}{figure.caption.19}\protected@file@percent }
\newlabel{fig:decarli}{{S4}{4}{\textbf {Developmental dyscalculia and a coarser fitted width profile.} (a)~Exact accuracy per numerosity (points, group mean $\pm $ SEM; lines, the group-level model fit). (b)~Median response time, same conventions. (c)~Per-subject accuracy SSE of the two single-mechanism fits: the width-only model fits better than the noise-only model in $64/64$ subjects (all points below the diagonal). (d)~Per-subject continuous width index $n_{\mathrm {width}}$ from free-scale fits with a shared exponent at the task's $500$~ms exposure. Horizontal lines mark group medians; children with DD have lower $n_{\mathrm {width}}$ than controls (Mann--Whitney $p=0.018$, $r_{\mathrm {rb}}=-0.35$)}{figure.caption.19}{}}
