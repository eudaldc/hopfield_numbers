\@writefile{toc}{\contentsline {paragraph}{The landscape is intrinsically small-range.}{3}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Cross-channel convergence with the response-time plateau.}{3}{section*.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Small-range refit.} The fitted width exponent $\beta $ (\textbf  {a}) and the resolution limit $n_{\mathrm  {crit}}$ (\textbf  {b}), from the full-range fit ($n \le 15$, filled) and from a refit on the small range ($n \le 10$, open). Both are essentially unchanged for 80--640~ms; only the noise-dominated 40~ms flash shifts. The discrete, exact behaviour is intrinsic to the small-number range.}}{3}{figure.caption.20}\protected@file@percent }
\newlabel{fig:ncap}{{S2}{3}{\textbf {Small-range refit.} The fitted width exponent $\beta $ (\textbf {a}) and the resolution limit $n_{\mathrm {crit}}$ (\textbf {b}), from the full-range fit ($n \le 15$, filled) and from a refit on the small range ($n \le 10$, open). Both are essentially unchanged for 80--640~ms; only the noise-dominated 40~ms flash shifts. The discrete, exact behaviour is intrinsic to the small-number range}{figure.caption.20}{}}
