\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Parameter recovery of the winning model.} Recovered versus generating values for the five fitted parameters and the derived $n_{\mathrm  {crit}}$ and $\sigma _3$, coloured by exposure duration; dashed lines are identity. The bottom-right panel is the Spearman correlation matrix of recovery errors, showing the single strong $s_0$--$\lambda _0$ trade-off.}}{3}{figure.caption.17}\protected@file@percent }
\newlabel{fig:recovery}{{S1}{3}{\textbf {Parameter recovery of the winning model.} Recovered versus generating values for the five fitted parameters and the derived $n_{\mathrm {crit}}$ and $\sigma _3$, coloured by exposure duration; dashed lines are identity. The bottom-right panel is the Spearman correlation matrix of recovery errors, showing the single strong $s_0$--$\lambda _0$ trade-off}{figure.caption.17}{}}
