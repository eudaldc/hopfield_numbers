\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Trial-level response model comparison.} Categorical information criteria over the ${\sim }53{,}000$ individual responses, summed over the five exposure durations, relative to the best model. $k$ is the total free-parameter count (per-duration mechanism parameters plus lapse). ``Attractor'' includes the clean-up dynamics; ``readout'' is the matched static control at the same $k$. The width-model rows carry one parameter more than the Weber/ANS and normative benchmarks (the free width exponent); at this sample size BIC charges ${\approx }9$ per parameter against AIC's $2$, yet the ranking and margins barely change, so the advantage is not a parameter-count artefact.}}{2}{table.caption.8}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:ladder}{{S1}{2}{\textbf {Trial-level response model comparison.} Categorical information criteria over the ${\sim }53{,}000$ individual responses, summed over the five exposure durations, relative to the best model. $k$ is the total free-parameter count (per-duration mechanism parameters plus lapse). ``Attractor'' includes the clean-up dynamics; ``readout'' is the matched static control at the same $k$. The width-model rows carry one parameter more than the Weber/ANS and normative benchmarks (the free width exponent); at this sample size BIC charges ${\approx }9$ per parameter against AIC's $2$, yet the ranking and margins barely change, so the advantage is not a parameter-count artefact}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Fitted parameters of the winning model across exposure durations.} $\sigma _c$ and $\beta $ set the well-width law $\sigma _n = (\sigma _c/f_n)^\beta $; $s_0$ and $\lambda _0$ the sensory-noise profile $\sigma (n)$; $\ell $ the lapse. The 40~ms flash is noise-dominated (large $s_0$, extreme $\beta $); from 80~ms the parameters vary smoothly.}}{2}{table.caption.11}\protected@file@percent }
\newlabel{tab:params}{{S2}{2}{\textbf {Fitted parameters of the winning model across exposure durations.} $\sigma _c$ and $\beta $ set the well-width law $\sigma _n = (\sigma _c/f_n)^\beta $; $s_0$ and $\lambda _0$ the sensory-noise profile $\sigma (n)$; $\ell $ the lapse. The 40~ms flash is noise-dominated (large $s_0$, extreme $\beta $); from 80~ms the parameters vary smoothly}{table.caption.11}{}}
