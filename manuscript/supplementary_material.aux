\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Parameter recovery of the winning model.} Recovered versus generating values for the five fitted parameters and the derived $n_{\mathrm  {crit}}$ and $\sigma _3$, coloured by exposure duration; dashed lines are identity. The bottom-right panel is the Spearman correlation matrix of recovery errors, showing the single strong $s_0$--$\lambda _0$ trade-off.}}{4}{figure.caption.13}\protected@file@percent }
\newlabel{fig:recovery}{{S1}{4}{\textbf {Parameter recovery of the winning model.} Recovered versus generating values for the five fitted parameters and the derived $n_{\mathrm {crit}}$ and $\sigma _3$, coloured by exposure duration; dashed lines are identity. The bottom-right panel is the Spearman correlation matrix of recovery errors, showing the single strong $s_0$--$\lambda _0$ trade-off}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Small-range refit.} The fitted width exponent $\beta $ (\textbf  {a}) and the resolution limit $n_{\mathrm  {crit}}$ (\textbf  {b}), from the full-range fit ($n \le 15$, filled) and from a refit on the small range ($n \le 10$, open). Both are essentially unchanged for 80--640~ms; only the noise-dominated 40~ms flash shifts. The discrete, exact behaviour is intrinsic to the small-number range.}}{4}{figure.caption.15}\protected@file@percent }
\newlabel{fig:ncap}{{S2}{4}{\textbf {Small-range refit.} The fitted width exponent $\beta $ (\textbf {a}) and the resolution limit $n_{\mathrm {crit}}$ (\textbf {b}), from the full-range fit ($n \le 15$, filled) and from a refit on the small range ($n \le 10$, open). Both are essentially unchanged for 80--640~ms; only the noise-dominated 40~ms flash shifts. The discrete, exact behaviour is intrinsic to the small-number range}{figure.caption.15}{}}
\newlabel{LastPage}{{}{4}{Supplementary Material 5: Exploratory reanalysis of developmental dyscalculia}{section*.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Response time within and beyond the exact range.} Predicted geometric-mean RT (solid, $n < n_{\mathrm  {crit}}$; dashed, extrapolated above) against the data. Within the exact range the model tracks RT; above $n_{\mathrm  {crit}}$ it over-predicts, the signature of the switch to approximate responding. The RT plateau onset coincides with the independently derived $n_{\mathrm  {crit}}$.}}{5}{figure.caption.16}\protected@file@percent }
\newlabel{fig:rtdomain}{{S3}{5}{\textbf {Response time within and beyond the exact range.} Predicted geometric-mean RT (solid, $n < n_{\mathrm {crit}}$; dashed, extrapolated above) against the data. Within the exact range the model tracks RT; above $n_{\mathrm {crit}}$ it over-predicts, the signature of the switch to approximate responding. The RT plateau onset coincides with the independently derived $n_{\mathrm {crit}}$}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {The exact-accuracy shoulder is a clean-up signature.} Predicted proportion of exact responses at 80~ms (\textbf  {a}) and 640~ms (\textbf  {b}) with the clean-up dynamics on (solid) and off (dashed), at identical parameters; dotted verticals mark $n_{\mathrm  {crit}}$. The shoulder sits at $n_{\mathrm  {crit}}$ and disappears without clean-up: it reflects the discrete basins on the integer lattice, not extra parameters.}}{5}{figure.caption.17}\protected@file@percent }
\newlabel{fig:pexact}{{S4}{5}{\textbf {The exact-accuracy shoulder is a clean-up signature.} Predicted proportion of exact responses at 80~ms (\textbf {a}) and 640~ms (\textbf {b}) with the clean-up dynamics on (solid) and off (dashed), at identical parameters; dotted verticals mark $n_{\mathrm {crit}}$. The shoulder sits at $n_{\mathrm {crit}}$ and disappears without clean-up: it reflects the discrete basins on the integer lattice, not extra parameters}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {The effective Weber fraction.} Coefficient of variation of the response distribution $w_{\mathrm  {eff}}(n)$ per numerosity, for each exposure duration; solid lines are the model (the fitted response distribution, lapse included, restricted to in-support and renormalised), dots the data (in-support responses), and dotted verticals mark $n_{\mathrm  {crit}}$. The model tracks the data across the whole range; across the estimation range ($n \ge n_{\mathrm  {crit}}$) the CoV settles to a roughly constant plateau, approximately scalar variability (Weber's law). The 40~ms flash is noise-dominated and has no exact range.}}{5}{figure.caption.18}\protected@file@percent }
\newlabel{fig:weber}{{S5}{5}{\textbf {The effective Weber fraction.} Coefficient of variation of the response distribution $w_{\mathrm {eff}}(n)$ per numerosity, for each exposure duration; solid lines are the model (the fitted response distribution, lapse included, restricted to in-support and renormalised), dots the data (in-support responses), and dotted verticals mark $n_{\mathrm {crit}}$. The model tracks the data across the whole range; across the estimation range ($n \ge n_{\mathrm {crit}}$) the CoV settles to a roughly constant plateau, approximately scalar variability (Weber's law). The 40~ms flash is noise-dominated and has no exact range}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces \textbf  {Developmental dyscalculia as a shorter exact number code.} (a)~Exact accuracy per numerosity (points, group mean $\pm $ SEM; lines, the group-level model fit). (b)~Median response time, same conventions. (c)~Per-subject accuracy SSE of the two single-mechanism fits: the resolution-only model fits better than the noise-only model in $64/64$ subjects (all points below the diagonal). (d)~Per-subject resolution limit $n_{\mathrm  {crit}}$ ($\sigma _n = 1$) from the resolution-only accuracy fits, at the task's $500$~ms exposure. Boxes, median and interquartile range; whiskers, $1.5\times $ IQR; points, individual subjects; the bracket gives the Mann--Whitney $p$ and the rank-biserial correlation $r_{\mathrm  {rb}}$ (negative: DD resolve to fewer numerosities) for this accuracy-only analysis.}}{5}{figure.caption.20}\protected@file@percent }
\newlabel{fig:decarli}{{S6}{5}{\textbf {Developmental dyscalculia as a shorter exact number code.} (a)~Exact accuracy per numerosity (points, group mean $\pm $ SEM; lines, the group-level model fit). (b)~Median response time, same conventions. (c)~Per-subject accuracy SSE of the two single-mechanism fits: the resolution-only model fits better than the noise-only model in $64/64$ subjects (all points below the diagonal). (d)~Per-subject resolution limit $n_{\mathrm {crit}}$ ($\sigma _n = 1$) from the resolution-only accuracy fits, at the task's $500$~ms exposure. Boxes, median and interquartile range; whiskers, $1.5\times $ IQR; points, individual subjects; the bracket gives the Mann--Whitney $p$ and the rank-biserial correlation $r_{\mathrm {rb}}$ (negative: DD resolve to fewer numerosities) for this accuracy-only analysis}{figure.caption.20}{}}
