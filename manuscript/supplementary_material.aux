\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Parameter recovery of the shared-landscape model.} Recovered versus generating values for the five fitted parameters and the derived $n_{\mathrm  {width}}$ and $\sigma _3$; dashed lines are identity. Shared landscape quantities are shown once per complete dataset in black, whereas duration-specific quantities are coloured by exposure duration. The bottom-right panel is the Spearman correlation matrix of recovery errors, showing the two main trade-offs, $\sigma _c$--$p$ and $s_0$--$\lambda _0$.}}{4}{figure.caption.8}\protected@file@percent }
\newlabel{fig:recovery}{{S2}{4}{\textbf {Parameter recovery of the shared-landscape model.} Recovered versus generating values for the five fitted parameters and the derived $n_{\mathrm {width}}$ and $\sigma _3$; dashed lines are identity. Shared landscape quantities are shown once per complete dataset in black, whereas duration-specific quantities are coloured by exposure duration. The bottom-right panel is the Spearman correlation matrix of recovery errors, showing the two main trade-offs, $\sigma _c$--$p$ and $s_0$--$\lambda _0$}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Clean-up generates an exact-accuracy shoulder.} The shoulder is generated by the integer clean-up dynamics and disappears in the matched static control. It is more pronounced than in the behavioural data, making it both a distinctive prediction of the mechanism and a residual of the current homogeneous landscape. Predicted proportion of exact responses at 80~ms (\textbf  {a}) and 640~ms (\textbf  {b}) with clean-up on (solid) and off (dashed), at identical parameters; dotted verticals mark $n_{\mathrm  {width}}$. The shoulder occurs near this width-based proxy and disappears without clean-up.}}{4}{figure.caption.11}\protected@file@percent }
\newlabel{fig:pexact}{{S3}{4}{\textbf {Clean-up generates an exact-accuracy shoulder.} The shoulder is generated by the integer clean-up dynamics and disappears in the matched static control. It is more pronounced than in the behavioural data, making it both a distinctive prediction of the mechanism and a residual of the current homogeneous landscape. Predicted proportion of exact responses at 80~ms (\textbf {a}) and 640~ms (\textbf {b}) with clean-up on (solid) and off (dashed), at identical parameters; dotted verticals mark $n_{\mathrm {width}}$. The shoulder occurs near this width-based proxy and disappears without clean-up}{figure.caption.11}{}}
