\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Response time around the width-based index.} Predicted geometric-mean RT against the data, shown solid for $n<n_{\mathrm  {width}}$ and dashed above it. This segmentation visualizes the location of the continuous width proxy; it does not define an exact-range or model-validity boundary.}}{5}{figure.caption.16}\protected@file@percent }
\newlabel{fig:rtdomain}{{S3}{5}{\textbf {Response time around the width-based index.} Predicted geometric-mean RT against the data, shown solid for $n<n_{\mathrm {width}}$ and dashed above it. This segmentation visualizes the location of the continuous width proxy; it does not define an exact-range or model-validity boundary}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {The exact-accuracy shoulder is a clean-up signature.} Predicted proportion of exact responses at 80~ms (\textbf  {a}) and 640~ms (\textbf  {b}) with clean-up on (solid) and off (dashed), at identical parameters; dotted verticals mark $n_{\mathrm  {width}}$. The shoulder occurs near this width-based proxy and disappears without clean-up.}}{5}{figure.caption.17}\protected@file@percent }
\newlabel{fig:pexact}{{S4}{5}{\textbf {The exact-accuracy shoulder is a clean-up signature.} Predicted proportion of exact responses at 80~ms (\textbf {a}) and 640~ms (\textbf {b}) with clean-up on (solid) and off (dashed), at identical parameters; dotted verticals mark $n_{\mathrm {width}}$. The shoulder occurs near this width-based proxy and disappears without clean-up}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {The effective Weber fraction.} Coefficient of variation of the response distribution $w_{\mathrm  {eff}}(n)$ per numerosity and exposure duration. Solid lines are the model (lapse included, restricted to in-support responses and renormalised), dots are the data, and dotted verticals mark $n_{\mathrm  {width}}$. The lines approach a roughly constant plateau at larger numerosities. The verticals identify the width-based analysis cutoff, not a topological or exact-range boundary.}}{5}{figure.caption.18}\protected@file@percent }
\newlabel{fig:weber}{{S5}{5}{\textbf {The effective Weber fraction.} Coefficient of variation of the response distribution $w_{\mathrm {eff}}(n)$ per numerosity and exposure duration. Solid lines are the model (lapse included, restricted to in-support responses and renormalised), dots are the data, and dotted verticals mark $n_{\mathrm {width}}$. The lines approach a roughly constant plateau at larger numerosities. The verticals identify the width-based analysis cutoff, not a topological or exact-range boundary}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces \textbf  {Developmental dyscalculia and the fitted width profile.} (a)~Exact accuracy per numerosity (points, group mean $\pm $ SEM; lines, the group-level model fit). (b)~Median response time, same conventions. (c)~Per-subject accuracy SSE of the two single-mechanism fits: the width-only model fits better than the noise-only model in $64/64$ subjects (all points below the diagonal). (d)~Per-subject $n_{\mathrm  {width}}$, defined by $\sigma _n=1$, from the width-only accuracy fits at the task's $500$~ms exposure. Boxes show the median and interquartile range; whiskers show $1.5\times $ IQR; points are individual subjects. The bracket gives the Mann--Whitney $p$ and rank-biserial correlation $r_{\mathrm  {rb}}$ for this accuracy-only analysis.}}{5}{figure.caption.20}\protected@file@percent }
\newlabel{fig:decarli}{{S6}{5}{\textbf {Developmental dyscalculia and the fitted width profile.} (a)~Exact accuracy per numerosity (points, group mean $\pm $ SEM; lines, the group-level model fit). (b)~Median response time, same conventions. (c)~Per-subject accuracy SSE of the two single-mechanism fits: the width-only model fits better than the noise-only model in $64/64$ subjects (all points below the diagonal). (d)~Per-subject $n_{\mathrm {width}}$, defined by $\sigma _n=1$, from the width-only accuracy fits at the task's $500$~ms exposure. Boxes show the median and interquartile range; whiskers show $1.5\times $ IQR; points are individual subjects. The bracket gives the Mann--Whitney $p$ and rank-biserial correlation $r_{\mathrm {rb}}$ for this accuracy-only analysis}{figure.caption.20}{}}
