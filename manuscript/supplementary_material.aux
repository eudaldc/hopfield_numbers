\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Energy landscape of the Gaussian--Benford attractor wells for $n = 1 \ldots  15$.} In~\textbf  {a}, the energy landscape $E(x)$ is shaped by Gaussian wells whose width is modulated by Benford's law frequency (pink curve, right axis): $n = 1$, the most frequent number, occupies the narrowest basin, while larger, rarer numbers produce progressively wider and more overlapping basins. This contrasts with the Poisson parameterization (main text, Fig.~\ref {main-fig:conceptual}), where the same qualitative asymmetry arises from accumulator statistics rather than environmental exposure. In~\textbf  {b}, the posterior entropy landscape $H(n)$ illustrates the consequences for pattern completion: small numerosities yield sharply peaked posteriors, whereas larger numerosities spread probability over several neighbouring wells.}}{1}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:gaussian}{{S1}{1}{\textbf {Energy landscape of the Gaussian--Benford attractor wells for $n = 1 \ldots 15$.} In~\textbf {a}, the energy landscape $E(x)$ is shaped by Gaussian wells whose width is modulated by Benford's law frequency (pink curve, right axis): $n = 1$, the most frequent number, occupies the narrowest basin, while larger, rarer numbers produce progressively wider and more overlapping basins. This contrasts with the Poisson parameterization (main text, Fig.~\ref {main-fig:conceptual}), where the same qualitative asymmetry arises from accumulator statistics rather than environmental exposure. In~\textbf {b}, the posterior entropy landscape $H(n)$ illustrates the consequences for pattern completion: small numerosities yield sharply peaked posteriors, whereas larger numerosities spread probability over several neighbouring wells}{figure.caption.2}{}}
\newlabel{eq:gaussian_posterior}{{S3}{1}{Model specification}{equation.3}{}}
