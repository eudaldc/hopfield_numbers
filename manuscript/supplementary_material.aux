\citation{decarli_impaired_2020}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Response time within and beyond the exact range.} Predicted geometric-mean RT (solid, $n < n_{\mathrm  {crit}}$; dashed, extrapolated above) against the data. Within the exact range the model tracks RT; above $n_{\mathrm  {crit}}$ it over-predicts, the signature of the switch to approximate responding. The RT plateau onset coincides with the independently derived $n_{\mathrm  {crit}}$.}}{4}{figure.caption.22}\protected@file@percent }
\newlabel{fig:rtdomain}{{S3}{4}{\textbf {Response time within and beyond the exact range.} Predicted geometric-mean RT (solid, $n < n_{\mathrm {crit}}$; dashed, extrapolated above) against the data. Within the exact range the model tracks RT; above $n_{\mathrm {crit}}$ it over-predicts, the signature of the switch to approximate responding. The RT plateau onset coincides with the independently derived $n_{\mathrm {crit}}$}{figure.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {The exact-accuracy shoulder is a clean-up signature.} Top: the fitted well-width and sensory-noise profiles are smooth. Bottom: the proportion of exact responses shows a discrete shoulder with clean-up on (solid) that disappears with clean-up off (dashed), the discrete basins on the integer lattice, not extra parameters.}}{4}{figure.caption.24}\protected@file@percent }
\newlabel{fig:pexact}{{S4}{4}{\textbf {The exact-accuracy shoulder is a clean-up signature.} Top: the fitted well-width and sensory-noise profiles are smooth. Bottom: the proportion of exact responses shows a discrete shoulder with clean-up on (solid) that disappears with clean-up off (dashed), the discrete basins on the integer lattice, not extra parameters}{figure.caption.24}{}}
\@writefile{toc}{\contentsline {section}{Supplementary Material 5: Exploratory reanalysis of developmental dyscalculia}{4}{section*.27}\protected@file@percent }
\newlabel{sm:dyscalculia}{{}{4}{Supplementary Material 5: Exploratory reanalysis of developmental dyscalculia}{section*.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {The effective Weber fraction.} Coefficient of variation of the response distribution $w_{\mathrm  {eff}}(n)$ per numerosity, for each exposure duration; solid lines are the model (the fitted response distribution, lapse included, restricted to in-support and renormalised), dots the data (in-support responses), and dotted verticals mark $n_{\mathrm  {crit}}$. The model tracks the data across the whole range; across the estimation range ($n \ge n_{\mathrm  {crit}}$) the CoV settles to a roughly constant plateau, approximately scalar variability (Weber's law). The 40~ms flash is noise-dominated and has no exact range.}}{4}{figure.caption.26}\protected@file@percent }
\newlabel{fig:weber}{{S5}{4}{\textbf {The effective Weber fraction.} Coefficient of variation of the response distribution $w_{\mathrm {eff}}(n)$ per numerosity, for each exposure duration; solid lines are the model (the fitted response distribution, lapse included, restricted to in-support and renormalised), dots the data (in-support responses), and dotted verticals mark $n_{\mathrm {crit}}$. The model tracks the data across the whole range; across the estimation range ($n \ge n_{\mathrm {crit}}$) the CoV settles to a roughly constant plateau, approximately scalar variability (Weber's law). The 40~ms flash is noise-dominated and has no exact range}{figure.caption.26}{}}
