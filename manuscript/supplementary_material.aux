\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Trial-level response model comparison.} Categorical information criteria over the ${\sim }53{,}000$ individual responses, summed over the five exposure durations, relative to the best model. $k$ is the total free-parameter count (per-duration mechanism parameters plus lapse). ``Attractor'' includes the clean-up dynamics; ``readout'' is the matched static control at the same $k$. The width-model rows carry one parameter more than the Weber/ANS and normative benchmarks (the free width exponent); at this sample size BIC charges ${\approx }9$ per parameter against AIC's $2$, yet the ranking and margins barely change, so the advantage is not a parameter-count artefact.}}{2}{table.caption.8}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:ladder}{{S1}{2}{\textbf {Trial-level response model comparison.} Categorical information criteria over the ${\sim }53{,}000$ individual responses, summed over the five exposure durations, relative to the best model. $k$ is the total free-parameter count (per-duration mechanism parameters plus lapse). ``Attractor'' includes the clean-up dynamics; ``readout'' is the matched static control at the same $k$. The width-model rows carry one parameter more than the Weber/ANS and normative benchmarks (the free width exponent); at this sample size BIC charges ${\approx }9$ per parameter against AIC's $2$, yet the ranking and margins barely change, so the advantage is not a parameter-count artefact}{table.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Fitted parameters of the winning model across exposure durations.} $\sigma _c$ and $\beta $ set the well-width law $\sigma _n = (\sigma _c/f_n)^\beta $; $s_0$ and $\lambda _0$ the sensory-noise profile $\sigma (n)$; $\ell $ the lapse. The 40~ms flash is noise-dominated (large $s_0$, extreme $\beta $); from 80~ms the parameters vary smoothly.}}{2}{table.caption.9}\protected@file@percent }
\newlabel{tab:params}{{S2}{2}{\textbf {Fitted parameters of the winning model across exposure durations.} $\sigma _c$ and $\beta $ set the well-width law $\sigma _n = (\sigma _c/f_n)^\beta $; $s_0$ and $\lambda _0$ the sensory-noise profile $\sigma (n)$; $\ell $ the lapse. The 40~ms flash is noise-dominated (large $s_0$, extreme $\beta $); from 80~ms the parameters vary smoothly}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Joint fit: one landscape shared across the five durations.} Categorical information criteria over the ${\sim }53{,}000$ responses relative to the best model. The four well models share their landscape ($\sigma _c$ and the width exponent) across durations, with the sensory channel and lapse free per duration ($k = 17$). The Weber/ANS and normative benchmarks have no landscape separable from their sensory noise, so they keep their fully free per-duration fit ($k = 20$); the attractor's single landscape wins even against that extra freedom.}}{2}{table.caption.10}\protected@file@percent }
\newlabel{tab:joint}{{S3}{2}{\textbf {Joint fit: one landscape shared across the five durations.} Categorical information criteria over the ${\sim }53{,}000$ responses relative to the best model. The four well models share their landscape ($\sigma _c$ and the width exponent) across durations, with the sensory channel and lapse free per duration ($k = 17$). The Weber/ANS and normative benchmarks have no landscape separable from their sensory noise, so they keep their fully free per-duration fit ($k = 20$); the attractor's single landscape wins even against that extra freedom}{table.caption.10}{}}
