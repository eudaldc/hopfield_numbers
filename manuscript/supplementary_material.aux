\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Trial-level response-model comparison (joint shared-landscape fit).} $k$ is the total number of free parameters over all five durations. Information criteria use all $52{,}995$ responses and are reported relative to the power-law attractor. The joint power-law models share $\sigma _c$ and $p$; the constant-width ablations fix $p=0$ and share only $\sigma _c$. In all cases, $s_0$, $\lambda _0$, and lapse are fitted per duration. The clean-up (attractor) models additionally count the shared give-up budget $G$ (\hyperref  [sm:methods]{Supplementary Material~1}) in $k$, so turning the clean-up on adds one parameter. Weber/ANS remains fully duration-specific. The C\&P model shares $B$ and $R$ but uses a duration-specific lapse ($k=7$).}}{3}{table.caption.12}\protected@file@percent }
\newlabel{tab:ladder}{{S2}{3}{\textbf {Trial-level response-model comparison (joint shared-landscape fit).} $k$ is the total number of free parameters over all five durations. Information criteria use all $52{,}995$ responses and are reported relative to the power-law attractor. The joint power-law models share $\sigma _c$ and $p$; the constant-width ablations fix $p=0$ and share only $\sigma _c$. In all cases, $s_0$, $\lambda _0$, and lapse are fitted per duration. The clean-up (attractor) models additionally count the shared give-up budget $G$ (\hyperref [sm:methods]{Supplementary Material~1}) in $k$, so turning the clean-up on adds one parameter. Weber/ANS remains fully duration-specific. The C\&P model shares $B$ and $R$ but uses a duration-specific lapse ($k=7$)}{table.caption.12}{}}
\newlabel{tab:model_comparison}{{S2}{3}{\textbf {Trial-level response-model comparison (joint shared-landscape fit).} $k$ is the total number of free parameters over all five durations. Information criteria use all $52{,}995$ responses and are reported relative to the power-law attractor. The joint power-law models share $\sigma _c$ and $p$; the constant-width ablations fix $p=0$ and share only $\sigma _c$. In all cases, $s_0$, $\lambda _0$, and lapse are fitted per duration. The clean-up (attractor) models additionally count the shared give-up budget $G$ (\hyperref [sm:methods]{Supplementary Material~1}) in $k$, so turning the clean-up on adds one parameter. Weber/ANS remains fully duration-specific. The C\&P model shares $B$ and $R$ but uses a duration-specific lapse ($k=7$)}{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {The purely driven model captures the wrong integer.} State $x(t)$ of the purely driven model on the winning (sharp) landscape at 320~ms, for five example trials each at \textbf  {a}, $n=2$; \textbf  {b}, $n=4$; \textbf  {c}, $n=8$; \textbf  {d}, $n=12$. Black dots mark item registrations; the dotted line is one trial's running count $K(t)$; the dashed line is the true $n$. Driven by the accumulating count, the state is captured by whichever integer the partial count currently resembles and is dragged up through the wrong wells; for small $n$ it is trapped near $1$, and for large $n$ it has not reached $n$ by offset, with high across-trial variance. A partial count is not diagnostic of the total, so it is a poor retrieval cue.}}{3}{figure.caption.13}\protected@file@percent }
\newlabel{fig:puredriven}{{S1}{3}{\textbf {The purely driven model captures the wrong integer.} State $x(t)$ of the purely driven model on the winning (sharp) landscape at 320~ms, for five example trials each at \textbf {a}, $n=2$; \textbf {b}, $n=4$; \textbf {c}, $n=8$; \textbf {d}, $n=12$. Black dots mark item registrations; the dotted line is one trial's running count $K(t)$; the dashed line is the true $n$. Driven by the accumulating count, the state is captured by whichever integer the partial count currently resembles and is dragged up through the wrong wells; for small $n$ it is trapped near $1$, and for large $n$ it has not reached $n$ by offset, with high across-trial variance. A partial count is not diagnostic of the total, so it is a poor retrieval cue}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {section}{Supplementary Material 3: Parameter recovery}{3}{section*.14}\protected@file@percent }
\newlabel{sm:recovery}{{}{3}{Supplementary Material 3: Parameter recovery}{section*.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Trial-level parameter recovery of the winning model.} Identity $R^2$ and Spearman $\rho $ between generating and recovered values across the $100$ synthetic datasets. Scale parameters are compared on the log scale. The interpreted quantities are the derived ones (lower block): $n_{\mathrm  {width}}$ is a heavy-tailed transform of the strongly traded-off $(\sigma _c, p)$, so its identity $R^2$ is uninformative and it is summarised by rank.}}{3}{table.caption.15}\protected@file@percent }
\newlabel{tab:recovery}{{S3}{3}{\textbf {Trial-level parameter recovery of the winning model.} Identity $R^2$ and Spearman $\rho $ between generating and recovered values across the $100$ synthetic datasets. Scale parameters are compared on the log scale. The interpreted quantities are the derived ones (lower block): $n_{\mathrm {width}}$ is a heavy-tailed transform of the strongly traded-off $(\sigma _c, p)$, so its identity $R^2$ is uninformative and it is summarised by rank}{table.caption.15}{}}
