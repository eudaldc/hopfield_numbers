\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {Exploratory dyscalculia reanalysis.} (a--b)~Exact enumeration accuracy~(a) and reaction time~(b) from~\citet  {decarli_impaired_2020} for children with developmental dyscalculia (DD) and age-matched controls, with model fits overlaid. The analysis uses numerosities $n=1$--7; $n=8$ was excluded because of an anomalous empirical response pattern. (c)~Fitted model-parameter summaries shown separately for each group; box plots summarize bootstrap or profile-likelihood draws. The panel is descriptive; group comparisons are based on the identifiable derived quantities reported in Table~\ref {tab:dd_derived}.}}{5}{figure.caption.18}\protected@file@percent }
\newlabel{fig:decarli_supp}{{S4}{5}{\textbf {Exploratory dyscalculia reanalysis.} (a--b)~Exact enumeration accuracy~(a) and reaction time~(b) from~\citet {decarli_impaired_2020} for children with developmental dyscalculia (DD) and age-matched controls, with model fits overlaid. The analysis uses numerosities $n=1$--7; $n=8$ was excluded because of an anomalous empirical response pattern. (c)~Fitted model-parameter summaries shown separately for each group; box plots summarize bootstrap or profile-likelihood draws. The panel is descriptive; group comparisons are based on the identifiable derived quantities reported in Table~\ref {tab:dd_derived}}{figure.caption.18}{}}
