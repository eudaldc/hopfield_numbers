\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces \textbf  {Width-based and topological resolution indices.} The primary joint fit shares one landscape across durations; the remaining rows are the secondary duration-specific fits. $n_{\mathrm  {width}}$ is the continuous index defined by $\sigma _n=1$, whereas $n_{\mathrm  {topo}}$ is the last consecutive integer retaining its own basin.}}{4}{table.caption.14}\protected@file@percent }
\newlabel{tab:topological-limit}{{S4}{4}{\textbf {Width-based and topological resolution indices.} The primary joint fit shares one landscape across durations; the remaining rows are the secondary duration-specific fits. $n_{\mathrm {width}}$ is the continuous index defined by $\sigma _n=1$, whereas $n_{\mathrm {topo}}$ is the last consecutive integer retaining its own basin}{table.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Small-range refit.} The fitted width exponent $p$ (\textbf  {a}) and the continuous width-based index $n_{\mathrm  {width}}$ (\textbf  {b}), from the full-range fit ($n \le 15$, filled) and from a refit on the small range ($n \le 10$, open). Both are essentially unchanged at every duration.}}{4}{figure.caption.15}\protected@file@percent }
\newlabel{fig:ncap}{{S2}{4}{\textbf {Small-range refit.} The fitted width exponent $p$ (\textbf {a}) and the continuous width-based index $n_{\mathrm {width}}$ (\textbf {b}), from the full-range fit ($n \le 15$, filled) and from a refit on the small range ($n \le 10$, open). Both are essentially unchanged at every duration}{figure.caption.15}{}}
