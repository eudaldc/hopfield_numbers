\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {The exact-accuracy shoulder is a clean-up signature.} Predicted proportion of exact responses at 80~ms (\textbf  {a}) and 640~ms (\textbf  {b}) with clean-up on (solid) and off (dashed), at identical parameters; dotted verticals mark $n_{\mathrm  {width}}$. The shoulder occurs near this width-based proxy and disappears without clean-up.}}{3}{figure.caption.15}\protected@file@percent }
\newlabel{fig:pexact}{{S2}{3}{\textbf {The exact-accuracy shoulder is a clean-up signature.} Predicted proportion of exact responses at 80~ms (\textbf {a}) and 640~ms (\textbf {b}) with clean-up on (solid) and off (dashed), at identical parameters; dotted verticals mark $n_{\mathrm {width}}$. The shoulder occurs near this width-based proxy and disappears without clean-up}{figure.caption.15}{}}
