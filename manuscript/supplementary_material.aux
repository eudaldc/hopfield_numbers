\@writefile{toc}{\contentsline {paragraph}{Computing density from the Cheyette and Piantadosi (2020) display.}{3}{section*.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Parameter-recovery analysis across the five exposure durations.} Each point corresponds to one synthetic dataset generated from jittered fitted parameters and then refitted with the same optimization procedure used in the main analyses. Colours indicate exposure duration. The dashed grey lines show identity. The attractor well-scale parameter $c$ and the entropy-to-response-time scaling parameter $\kappa $ are recovered accurately. The sensory-noise parameters $s_0$ and $\lambda _0$ show partial trade-off, indicating that they should be interpreted jointly as defining the sensory-noise profile rather than as separately identifiable psychological quantities. The bottom panel shows the Spearman correlation matrix of recovery errors, highlighting the main trade-offs between $s_0$ and $\lambda _0$, and between $c$ and $\kappa $.}}{3}{figure.caption.9}\protected@file@percent }
\newlabel{fig:parameter-recovery}{{S2}{3}{\textbf {Parameter-recovery analysis across the five exposure durations.} Each point corresponds to one synthetic dataset generated from jittered fitted parameters and then refitted with the same optimization procedure used in the main analyses. Colours indicate exposure duration. The dashed grey lines show identity. The attractor well-scale parameter $c$ and the entropy-to-response-time scaling parameter $\kappa $ are recovered accurately. The sensory-noise parameters $s_0$ and $\lambda _0$ show partial trade-off, indicating that they should be interpreted jointly as defining the sensory-noise profile rather than as separately identifiable psychological quantities. The bottom panel shows the Spearman correlation matrix of recovery errors, highlighting the main trade-offs between $s_0$ and $\lambda _0$, and between $c$ and $\kappa $}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Functional compression from Poisson attractor wells.} Posterior distributions at well centres: for small $n$ the posteriors are sharply peaked and non-overlapping, supporting exact identification; as $n$ grows the distributions broaden and merge, producing the functional compression of the number line characteristic of approximate numerosity.}}{3}{figure.caption.11}\protected@file@percent }
\newlabel{fig:supp_compression}{{S3}{3}{\textbf {Functional compression from Poisson attractor wells.} Posterior distributions at well centres: for small $n$ the posteriors are sharply peaked and non-overlapping, supporting exact identification; as $n$ grows the distributions broaden and merge, producing the functional compression of the number line characteristic of approximate numerosity}{figure.caption.11}{}}
