\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Trial-level response-model comparison under joint and separate fits.} $k$ is the total number of free parameters over all five durations. Information criteria use all $52{,}995$ responses and are reported relative to the power-law attractor within each analysis. The joint power-law models share $\sigma _c$ and $p$; the constant-width ablations fix $p=0$ and share only $\sigma _c$. In both cases, $s_0$, $\lambda _0$, and lapse are fitted per duration. Weber/ANS remains fully duration-specific. The joint C\&P model shares $B$ and $R$ but uses a duration-specific lapse ($k=7$). In the separate analysis, every free parameter is fitted per duration; C\&P has a free information budget and lapse at each duration. Joint-fit BIC uses the pooled sample size, whereas separate-fit BIC is summed over the five duration-specific fits.}}{3}{table.caption.8}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:ladder}{{S1}{3}{\textbf {Trial-level response-model comparison under joint and separate fits.} $k$ is the total number of free parameters over all five durations. Information criteria use all $52{,}995$ responses and are reported relative to the power-law attractor within each analysis. The joint power-law models share $\sigma _c$ and $p$; the constant-width ablations fix $p=0$ and share only $\sigma _c$. In both cases, $s_0$, $\lambda _0$, and lapse are fitted per duration. Weber/ANS remains fully duration-specific. The joint C\&P model shares $B$ and $R$ but uses a duration-specific lapse ($k=7$). In the separate analysis, every free parameter is fitted per duration; C\&P has a free information budget and lapse at each duration. Joint-fit BIC uses the pooled sample size, whereas separate-fit BIC is summed over the five duration-specific fits}{table.caption.8}{}}
\newlabel{sup-tab:model_comparison}{{S1}{3}{\textbf {Trial-level response-model comparison under joint and separate fits.} $k$ is the total number of free parameters over all five durations. Information criteria use all $52{,}995$ responses and are reported relative to the power-law attractor within each analysis. The joint power-law models share $\sigma _c$ and $p$; the constant-width ablations fix $p=0$ and share only $\sigma _c$. In both cases, $s_0$, $\lambda _0$, and lapse are fitted per duration. Weber/ANS remains fully duration-specific. The joint C\&P model shares $B$ and $R$ but uses a duration-specific lapse ($k=7$). In the separate analysis, every free parameter is fitted per duration; C\&P has a free information budget and lapse at each duration. Joint-fit BIC uses the pooled sample size, whereas separate-fit BIC is summed over the five duration-specific fits}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces \textbf  {Parameter recovery of the winning model.} Recovered versus generating values for the five fitted parameters and the derived $n_{\mathrm  {width}}$ and $\sigma _3$, coloured by exposure duration; dashed lines are identity. The $n_{\mathrm  {width}}$ panel is clipped to its meaningful range: the on-diagonal bulk recovers well, while a few ridge fits (low exponent, near-equal likelihood) fall off-scale. The bottom-right panel is the Spearman correlation matrix of recovery errors, showing the two strong trade-offs, $\sigma _c$--$p$ and $s_0$--$\lambda _0$.}}{3}{figure.caption.12}\protected@file@percent }
\newlabel{fig:recovery}{{S1}{3}{\textbf {Parameter recovery of the winning model.} Recovered versus generating values for the five fitted parameters and the derived $n_{\mathrm {width}}$ and $\sigma _3$, coloured by exposure duration; dashed lines are identity. The $n_{\mathrm {width}}$ panel is clipped to its meaningful range: the on-diagonal bulk recovers well, while a few ridge fits (low exponent, near-equal likelihood) fall off-scale. The bottom-right panel is the Spearman correlation matrix of recovery errors, showing the two strong trade-offs, $\sigma _c$--$p$ and $s_0$--$\lambda _0$}{figure.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces \textbf  {Fitted parameters of the winning model across exposure durations.} $\sigma _c$ and $p$ set the well-width law $\sigma _n = \sigma _c\,n^{p}$; $s_0$ and $\lambda _0$ the sensory-noise profile $\sigma (n)$; $\ell $ the lapse. The 40~ms flash is noise-dominated (large $s_0$); from 80~ms the parameters vary smoothly. The scale $\sigma _c$ and exponent $p$ trade off (Supplementary Material~3) and are not interpreted singly.}}{3}{table.caption.9}\protected@file@percent }
\newlabel{tab:params}{{S2}{3}{\textbf {Fitted parameters of the winning model across exposure durations.} $\sigma _c$ and $p$ set the well-width law $\sigma _n = \sigma _c\,n^{p}$; $s_0$ and $\lambda _0$ the sensory-noise profile $\sigma (n)$; $\ell $ the lapse. The 40~ms flash is noise-dominated (large $s_0$); from 80~ms the parameters vary smoothly. The scale $\sigma _c$ and exponent $p$ trade off (Supplementary Material~3) and are not interpreted singly}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces \textbf  {Trial-level parameter recovery of the winning model.} Identity $R^2$ and Spearman $\rho $ between generating and recovered values across the $100$ synthetic datasets. Scale parameters are compared on the log scale. The interpreted quantities are the derived ones (lower block): $n_{\mathrm  {width}}$ is a heavy-tailed transform of the strongly traded-off $(\sigma _c, p)$, so its identity $R^2$ is uninformative and it is summarised by rank.}}{3}{table.caption.11}\protected@file@percent }
\newlabel{tab:recovery}{{S3}{3}{\textbf {Trial-level parameter recovery of the winning model.} Identity $R^2$ and Spearman $\rho $ between generating and recovered values across the $100$ synthetic datasets. Scale parameters are compared on the log scale. The interpreted quantities are the derived ones (lower block): $n_{\mathrm {width}}$ is a heavy-tailed transform of the strongly traded-off $(\sigma _c, p)$, so its identity $R^2$ is uninformative and it is summarised by rank}{table.caption.11}{}}
