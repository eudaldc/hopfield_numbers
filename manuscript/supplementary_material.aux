\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces \textbf  {Fitted parameters of the joint winning model.} Shared: $\sigma _c=0.0185$, $p=1.86$, $G=120$, $s_{00}=0.05$; selected RT link $\tau =0.01144$, $\kappa =0$, $t_0=1.30$~s (fixed). Sensory noise $(s_0,\lambda _0)$, lapse $\ell $, and RT residual $\sigma _{\mathrm  {rt}}$ vary by duration (landscape held fixed for the RT fit). Well support $m=1$--$19$; clean-up uses $\eta =1$, $\mathrm  {tol}=10^{-4}$, and the oscillation stop above. We summarize the scale and exponent jointly through $n_{\mathrm  {width}}=\sigma _c^{-1/p}=8.5$.}}{2}{table.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:params}{{S1}{2}{\textbf {Fitted parameters of the joint winning model.} Shared: $\sigma _c=0.0185$, $p=1.86$, $G=120$, $s_{00}=0.05$; selected RT link $\tau =0.01144$, $\kappa =0$, $t_0=1.30$~s (fixed). Sensory noise $(s_0,\lambda _0)$, lapse $\ell $, and RT residual $\sigma _{\mathrm {rt}}$ vary by duration (landscape held fixed for the RT fit). Well support $m=1$--$19$; clean-up uses $\eta =1$, $\mathrm {tol}=10^{-4}$, and the oscillation stop above. We summarize the scale and exponent jointly through $n_{\mathrm {width}}=\sigma _c^{-1/p}=8.5$}{table.caption.2}{}}
\@writefile{toc}{\contentsline {section}{Supplementary Material 2: Model comparison and constrained fits}{2}{section*.3}\protected@file@percent }
