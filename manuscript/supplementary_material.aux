\citation{cheyette_unified_2020}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces \textbf  {Shared-landscape control.} Pooled profile-Gaussian information criteria for the per-duration fit (free $c$, $\kappa $) versus the constrained model with $c$ and $\kappa $ shared across durations and only $s_0$, $\lambda _0$ free. ``All'' pools the five durations; ``80--640\,ms'' pools the four longer, more informative durations. Lower is better.}}{3}{table.caption.10}\protected@file@percent }
\newlabel{tab:supp_shared}{{S4}{3}{\textbf {Shared-landscape control.} Pooled profile-Gaussian information criteria for the per-duration fit (free $c$, $\kappa $) versus the constrained model with $c$ and $\kappa $ shared across durations and only $s_0$, $\lambda _0$ free. ``All'' pools the five durations; ``80--640\,ms'' pools the four longer, more informative durations. Lower is better}{table.caption.10}{}}
\@writefile{toc}{\contentsline {section}{Supplementary Material 3: Parameter Recovery}{3}{section*.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Parameter-recovery analysis across the five exposure durations.} Each point corresponds to one synthetic dataset generated from jittered fitted parameters and then refitted with the same optimization procedure used in the main analyses. Colours indicate exposure duration. The dashed grey lines show identity. The attractor well-scale parameter $c$ and the entropy-to-response-time scaling parameter $\kappa $ are recovered accurately. The sensory-noise parameters $s_0$ and $\lambda _0$ show partial trade-off, indicating that they should be interpreted jointly as defining the sensory-noise profile rather than as separately identifiable psychological quantities. The bottom panel shows the Spearman correlation matrix of recovery errors, highlighting the main trade-offs between $s_0$ and $\lambda _0$, and between $c$ and $\kappa $.}}{3}{figure.caption.12}\protected@file@percent }
\newlabel{fig:parameter-recovery}{{S2}{3}{\textbf {Parameter-recovery analysis across the five exposure durations.} Each point corresponds to one synthetic dataset generated from jittered fitted parameters and then refitted with the same optimization procedure used in the main analyses. Colours indicate exposure duration. The dashed grey lines show identity. The attractor well-scale parameter $c$ and the entropy-to-response-time scaling parameter $\kappa $ are recovered accurately. The sensory-noise parameters $s_0$ and $\lambda _0$ show partial trade-off, indicating that they should be interpreted jointly as defining the sensory-noise profile rather than as separately identifiable psychological quantities. The bottom panel shows the Spearman correlation matrix of recovery errors, highlighting the main trade-offs between $s_0$ and $\lambda _0$, and between $c$ and $\kappa $}{figure.caption.12}{}}
