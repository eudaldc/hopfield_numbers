\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {Developmental dyscalculia and a coarser fitted width profile.} (a)~Exact accuracy per numerosity (points, group mean $\pm $ SEM; lines, the group-level model fit). (b)~Median response time, same conventions. (c)~Per-subject accuracy SSE of the two single-mechanism fits: the width-only model fits better than the noise-only model in $64/64$ subjects (all points below the diagonal). (d)~Per-subject width index $n_{\mathrm  {width}}$ from free-scale fits with a shared exponent at the task's $500$~ms exposure. Boxes show the group interquartile range and median; children with DD have lower $n_{\mathrm  {width}}$ than controls (Mann--Whitney $p=0.018$, $r_{\mathrm  {rb}}=-0.35$).}}{5}{figure.caption.22}\protected@file@percent }
\newlabel{fig:decarli}{{S4}{5}{\textbf {Developmental dyscalculia and a coarser fitted width profile.} (a)~Exact accuracy per numerosity (points, group mean $\pm $ SEM; lines, the group-level model fit). (b)~Median response time, same conventions. (c)~Per-subject accuracy SSE of the two single-mechanism fits: the width-only model fits better than the noise-only model in $64/64$ subjects (all points below the diagonal). (d)~Per-subject width index $n_{\mathrm {width}}$ from free-scale fits with a shared exponent at the task's $500$~ms exposure. Boxes show the group interquartile range and median; children with DD have lower $n_{\mathrm {width}}$ than controls (Mann--Whitney $p=0.018$, $r_{\mathrm {rb}}=-0.35$)}{figure.caption.22}{}}
